{
  "workspace": ["./packages/core", "./packages/desktop"],
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:turbo@2.10.5 run dev",
    "build": "deno run -A npm:turbo@2.10.5 run build",
    "core": "deno task --filter @pidev/core start",
    "report": "deno run -A scripts/report.ts",
    "experiment": "deno run -A scripts/experiment.ts",
    "check": "deno run -A npm:turbo@2.10.5 run check",
    "test": "deno run -A npm:turbo@2.10.5 run test --filter=@pidev/core"
  }
}
