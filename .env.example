OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# optional: override if the configured model's real num_ctx (see its Modelfile)
# differs from the 32768/16384 defaults, else compaction won't fire in time
# and ollama will silently truncate context
OLLAMA_CONTEXT_WINDOW=32768
OLLAMA_MAX_TOKENS=16384
